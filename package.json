{
  "name": "dsh-agent-team-model-selection",
  "version": "0.1.0",
  "private": true,
  "description": "User-facing model switching for DSH Agent Teams teammates and addressed subagents.",
  "type": "module",
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "main": "./lib/index.js",
  "scripts": {
    "test": "node --test --test-isolation=none test/*.test.mjs"
  }
}
